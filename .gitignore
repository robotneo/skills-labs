# 忽略所有名为 .venv 的虚拟环境目录
.venv/
venv/
env/
.env

# 忽略 pyenv 生成的本地版本配置文件（可选，见下文说明）
# .python-version

# 忽略 Python 编译产生的缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 忽略操作系统和 IDE 配置文件
.DS_Store
.vscode/
.idea/
.python-version

# 打包产物（Skill hub 上传用）
*.zip

# 本地隔离开发工作区
.worktrees/

# WorkBuddy 本地工作记忆/日志（仅本机，勿入库）
.workbuddy/

# superpowers SDD 本地工作区/过程报告（仅本机，勿入库）
.superpowers/

# Python 打包/构建产物（pyproject.toml 仅供工具读取，无需提交这些）
build/
dist/
*.egg-info/
*.egg
