{
  "id": "enterprise-notification-bridge",
  "name": "企业通知桥接",
  "version": "1.0.0",
  "author": "hua",
  "description": "将经过验证的标准 Wi-Fi 健康报告发送到已配置的企业通知渠道，并保持报告内容不变。",
  "platforms": ["codex", "claude", "workbuddy", "openclaw", "generic"],
  "support_os": ["macos>=10.12", "windows-10", "windows-11", "linux"],
  "requirements": ["python>=3.7"],
  "conditional_requirements": {
    "dingtalk:dws-cli": ["dws>=1.0.15"]
  },
  "entry": {"macos": "run.sh", "windows": "run.bat", "powershell": "run.ps1", "compatibility": "main.py"},
  "output_type": ["json", "mcp-json-rpc"],
  "optional": true,
  "type": "internal-component",
  "repository": "https://github.com/robotneo/skills-labs/tree/main/wifi-health-detector/integrations/enterprise-notification-bridge"
}
